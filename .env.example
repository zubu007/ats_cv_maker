# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Choose which AI provider to use: "openai" or "anthropic"
AI_PROVIDER=openai

# Model to use (e.g., "gpt-4" for OpenAI or "claude-3-sonnet-20240229" for Anthropic)
MODEL_NAME=gpt-4

# ===== API CONFIGURATION =====
# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Environment (development or production)
ENVIRONMENT=development
AI_MODEL=gpt-4

# ===== DATABASE / AUTH =====
# PostgreSQL connection string for auth users + sessions
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ats_cv_maker

# Session cookie and auth configuration
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=ats_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
